# LLM Backend: llama.cpp (standalone binary + GGUF model)
LLM_BACKEND=llama.cpp
LLAMA_CPP_BIN=bin/llama/llama-server.exe
LLAMA_CPP_CLI_BIN=bin/llama/llama-cli.exe
LLAMA_CPP_MODEL=data/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
LLAMA_CPP_HOST=http://127.0.0.1:8080
LLAMA_CPP_THREADS=4

# Whisper is English-only tiny.en; it runs only after the Vosk wake listener hears "EMO".
WAKE_WORD_REQUIRED=true
WAKE_WORDS=emo,hey emo,hi emo,hello emo,okay emo,ok emo
VOSK_MODEL_PATH=~/.cache/emo/vosk-model-small-en-us-0.15
WHISPER_BACKEND=faster-whisper
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=false
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_MODEL=tiny.en
WHISPER_TRANSLATION_MODEL=tiny.en
WHISPER_DOWNLOAD_ROOT=~/.cache/emo/whisper-en
WHISPER_CPP_BIN=~/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=~/whisper.cpp/models/ggml-tiny.en.bin
WHISPER_CPP_THREADS=2
PRELOAD_WHISPER=false
AUDIO_SAMPLE_RATE=16000
AUDIO_INPUT_DEVICE=auto
AUDIO_RMS_THRESHOLD=0.012
MAX_UTTERANCE_SECONDS=8
TRAILING_SILENCE_SECONDS=0.75

# "auto" intentionally avoids Chatterbox on the Pi 3B+ low-memory default.
TTS_ENGINE=auto
CHATTERBOX_LANGUAGE_MODE=english
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8
# Optional voice-reference WAV; only use audio you have permission to use.
CHATTERBOX_REF_AUDIO=

# BCM numbering, not physical header numbering.
SERVO_GPIOS=5,6,12,13
TOUCH_GPIO=16
MPU6050_ENABLED=true
MPU6050_ADDRESSES=0x68,0x69

# For a supported SPI framebuffer set DISPLAY_DRIVER=fbcon and SDL_FBDEV=/dev/fb1.
DISPLAY_WIDTH=320
DISPLAY_HEIGHT=240
DISPLAY_FULLSCREEN=true
DISPLAY_DRIVER=auto
# SDL_FBDEV=/dev/fb1

# Flask remote control is disabled until REMOTE_CONTROL_TOKEN is set.
REMOTE_ENABLED=true
REMOTE_HOST=0.0.0.0
REMOTE_PORT=8766
REMOTE_CONTROL_TOKEN=

# Optional vision workers are disabled by default on Pi 3B+.
CAMERA_ENABLED=false
CAMERA_INDEX=0
GESTURE_ENABLED=false
FACE_RECOGNITION_ENABLED=false
OBJECT_CLASSIFICATION_ENABLED=false
KNOWN_FACES_DIR=./data/known_faces
VISION_MODEL=yolo11n.pt

EMO_SONG_DIR=./assets/songs
EMO_READY_SONG=emo_is_ready.mp3
WEATHER_CITY=
TIMEZONE=Asia/Kolkata
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
WEATHER_CACHE_TTL_SECONDS=300
EMO_DATA_DIR=./data
THERMAL_WARNING_C=75
THERMAL_LOCKOUT_C=82
THERMAL_RESUME_C=72
LOG_LEVEL=INFO
